const _trilogyt._created_at <- current_datetime();

import generic as generic;

rowset cte <- WHERE
    generic.split in (1, 2, 3)
SELECT
    generic.split,
    generic.scalar,
;

SELECT
    cte.generic.split,
;

OVERWRITE dsgeneric_scalar_445831a9 INTO dsgeneric_scalar_445831a9 FROM SELECT
    generic.int_array,
    generic.scalar,
;

OVERWRITE dsgeneric_scalar_0c9429cc INTO dsgeneric_scalar_0c9429cc FROM SELECT
    generic.scalar,
    generic.split,
;

OVERWRITE dscte_generic_split_4a0c66ea INTO dscte_generic_split_4a0c66ea FROM SELECT
    cte.generic.split,
;