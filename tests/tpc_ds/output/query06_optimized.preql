import _opt_store_sales_item_33b316c0;

MERGE store_sales.item.id into ~item.id;

property ticket_item <- concat(store_sales.ticket_number::string,'-',store_sales.item.id::string);

WHERE
    store_sales.date.year = 2001 and store_sales.item.category is not null and store_sales.date.month_of_year = 1 and store_sales.item.current_price > 1.2 * avg(item.current_price) by item.category
SELECT
    store_sales.customer.state,
    count(ticket_item) -> customer_count,
HAVING
    customer_count >= 10

ORDER BY
    customer_count asc nulls first,
    store_sales.customer.state asc nulls first
;