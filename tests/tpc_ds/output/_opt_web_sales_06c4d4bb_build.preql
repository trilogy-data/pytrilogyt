const _trilogyt._created_at <- current_datetime();

import web_sales as web_sales;

WHERE
    web_sales.date.date >= '1999-02-22'::date and web_sales.date.date <= '1999-03-24'::date and web_sales.item.category in ('Sports', 'Books', 'Home')
SELECT
    web_sales.item.name,
    web_sales.item.desc,
    web_sales.item.category,
    web_sales.item.class,
    web_sales.item.current_price,
    sum(web_sales.ext_sales_price) -> itemrevenue,
    --sum(itemrevenue) by web_sales.item.class -> itemclassrevenue,
    (itemrevenue * 100.0) / itemclassrevenue -> revenueratio,
ORDER BY
    web_sales.item.category asc,
    web_sales.item.class asc,
    web_sales.item.name asc,
    web_sales.item.desc asc,
    revenueratio asc
LIMIT 100
;

OVERWRITE dsweb_sales_item_category_web_sales_item_class_web_sales_item_current_price_web_sales_item_desc_web_sales_item_name_93d6159c_filtered_on_date_date_category INTO dsweb_sales_item_category_web_sales_item_class_web_sales_item_current_price_web_sales_item_desc_web_sales_item_name_93d6159c_filtered_on_date_date_category FROM WHERE
    web_sales.date.date >= '1999-02-22'::date and web_sales.date.date <= '1999-03-24'::date and web_sales.item.category in ('Sports', 'Books', 'Home')
SELECT
    itemrevenue,
    web_sales.item.category,
    web_sales.item.class,
    web_sales.item.current_price,
    web_sales.item.desc,
    web_sales.item.name,
;

OVERWRITE dsweb_sales_item_class_c7b1922f INTO dsweb_sales_item_class_c7b1922f FROM SELECT
    itemclassrevenue,
    web_sales.item.class,
;

OVERWRITE dsweb_sales_item_category_web_sales_item_class_web_sales_item_current_price_web_sales_item_desc_web_sales_item_name_1c30e378 INTO dsweb_sales_item_category_web_sales_item_class_web_sales_item_current_price_web_sales_item_desc_web_sales_item_name_1c30e378 FROM SELECT
    itemclassrevenue,
    itemrevenue,
    revenueratio,
    web_sales.item.category,
    web_sales.item.class,
    web_sales.item.current_price,
    web_sales.item.desc,
    web_sales.item.name,
;