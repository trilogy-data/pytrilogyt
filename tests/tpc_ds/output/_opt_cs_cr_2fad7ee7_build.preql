const _trilogyt._created_at <- current_datetime();

import catalog_sales as cs;

import catalog_returns as cr;

property multi_warehouse_sales <- filter cs.order_number where count(cs.warehouse.id) by cs.order_number > 1;

WHERE
    cs.ship_date.date >= '2002-02-01'::date and cs.ship_date.date <= '2002-04-02'::date and cs.customer_address.state = 'GA' and cs.call_center.county = 'Williamson County' and cs.order_number not in cr.order_number and cs.order_number in multi_warehouse_sales
SELECT
    count_distinct(cs.order_number) -> order_count,
    sum(cs.ext_ship_cost) -> total_shipping_cost,
    sum(cs.net_profit) -> total_net_profit,
ORDER BY
    order_count desc
LIMIT 100
;

OVERWRITE dscs_order_number_cs_warehouse_id_690359b8 INTO dscs_order_number_cs_warehouse_id_690359b8 FROM SELECT
    cs.order_number,
    cs.warehouse.id,
;

OVERWRITE dscr_order_number_ab93f574 INTO dscr_order_number_ab93f574 FROM SELECT
    cr.order_number,
;

OVERWRITE dslocal_multi_warehouse_sales_679f2d90 INTO dslocal_multi_warehouse_sales_679f2d90 FROM SELECT
    multi_warehouse_sales,
;

OVERWRITE dscs_call_center_id_cs_customer_address_id_cs_order_number_cs_ship_date_id_1b71cae0_filtered_on_order_number_order_number_order_number_multi_warehouse_sales INTO dscs_call_center_id_cs_customer_address_id_cs_order_number_cs_ship_date_id_1b71cae0_filtered_on_order_number_order_number_order_number_multi_warehouse_sales FROM WHERE
    cs.order_number not in cr.order_number and cs.order_number in multi_warehouse_sales
SELECT
    cs.call_center.id,
    cs.customer_address.id,
    cs.order_number,
    cs.ship_date.id,
;

OVERWRITE dstotal_net_profit_total_shipping_cost_c66c27a9_filtered_on_date_date_state_county_order_number_order_number_order_number_multi_warehouse_sales INTO dstotal_net_profit_total_shipping_cost_c66c27a9_filtered_on_date_date_state_county_order_number_order_number_order_number_multi_warehouse_sales FROM WHERE
    cs.ship_date.date >= '2002-02-01'::date and cs.ship_date.date <= '2002-04-02'::date and cs.customer_address.state = 'GA' and cs.call_center.county = 'Williamson County' and cs.order_number not in cr.order_number and cs.order_number in multi_warehouse_sales
SELECT
    total_net_profit,
    total_shipping_cost,
;

OVERWRITE dscs_order_number_a5e0ca39_filtered_on_date_date_state_county_order_number_order_number_order_number_multi_warehouse_sales INTO dscs_order_number_a5e0ca39_filtered_on_date_date_state_county_order_number_order_number_order_number_multi_warehouse_sales FROM WHERE
    cs.ship_date.date >= '2002-02-01'::date and cs.ship_date.date <= '2002-04-02'::date and cs.customer_address.state = 'GA' and cs.call_center.county = 'Williamson County' and cs.order_number not in cr.order_number and cs.order_number in multi_warehouse_sales
SELECT
    cs.order_number,
;

OVERWRITE dsorder_count_589cea8c INTO dsorder_count_589cea8c FROM SELECT
    order_count,
;

OVERWRITE dsorder_count_total_net_profit_total_shipping_cost_f1322888 INTO dsorder_count_total_net_profit_total_shipping_cost_f1322888 FROM SELECT
    order_count,
    total_net_profit,
    total_shipping_cost,
;