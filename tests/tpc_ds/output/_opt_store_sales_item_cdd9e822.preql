const _trilogyt._created_at <- current_datetime();

import store_sales as store_sales;

import item as item;

MERGE store_sales.item.id into ~item.id;

property ticket_item <- concat(store_sales.ticket_number::string,'-',item.id::string);

WHERE
    store_sales.date.year = 2001 and store_sales.item.category is not null and store_sales.date.month_of_year = 1 and store_sales.item.current_price > 1.2 * avg(item.current_price) by item.category
SELECT
    store_sales.customer.state,
    count(ticket_item) -> customer_count,
HAVING
    customer_count >= 10

ORDER BY
    customer_count asc nulls first,
    store_sales.customer.state asc nulls first
;

datasource dsitem_id_store_sales_customer_state_store_sales_date_month_of_year_store_sales_date_year_store_sales_ticket_number_8c6c8978_filtered_on_year_category_month_of_year (
    item_category: ~item.category,
    item_id: ~item.id,
    store_sales_customer_state: ~store_sales.customer.state,
    store_sales_date_month_of_year: ~store_sales.date.month_of_year,
    store_sales_date_year: ~store_sales.date.year,
    store_sales_item_category: ~store_sales.item.category,
    store_sales_item_current_price: ~store_sales.item.current_price,
    store_sales_ticket_number: ~store_sales.ticket_number
)
grain (item.id,store_sales.customer.state,store_sales.date.month_of_year,store_sales.date.year,store_sales.ticket_number)
complete where store_sales.date.year = 2001 and store_sales.item.category is not null and store_sales.date.month_of_year = 1
address dsitem_id_store_sales_customer_state_store_sales_date_month_of_year_store_sales_date_year_store_sales_ticket_number_8c6c8978_filtered_on_year_category_month_of_year;